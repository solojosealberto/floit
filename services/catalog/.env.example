PORT=4010
DATABASE_URL=postgresql://floit:floit@localhost:5432/floit_catalog
DATABASE_SYNC=true
SEED_ON_BOOT=true
# Admin taxonomías / media: OIDC (preferido) o token estático.
# Issuer debe ser URL absoluta (https://…). Host-only rompe JWKS → 500.
# ADMIN_OIDC_ISSUER=https://YOUR_TENANT.us.auth0.com
# ADMIN_OIDC_AUDIENCE=floit-admin
# ADMIN_AUTH_REQUIRE_OIDC=false
# Mismo valor que apps/web ADMIN_API_TOKEN si usas x-admin-token.
# ADMIN_API_TOKEN=
