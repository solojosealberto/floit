PORT=4013
# Local: omit DATABASE_URL → SQLite en services/partner/data/partner.sqlite
# Staging/prod (Neon): postgresql://...@.../partner?sslmode=require
# DATABASE_URL=
DATABASE_SYNC=true
CATALOG_SERVICE_URL=http://127.0.0.1:4010
PARTNER_TO_CATALOG_INTERNAL_TOKEN=change-me-same-as-catalog-internal
PARTNER_TO_LEADS_INTERNAL_TOKEN=change-me-same-as-leads-internal
ADMIN_AUTH_REQUIRE_OIDC=false
PARTNER_AUTH_REQUIRE_OIDC=false
# Absolute URL required (include https://). Host-only values break JWKS URL parsing → HTTP 500.
ADMIN_OIDC_ISSUER=https://YOUR_TENANT.us.auth0.com
PARTNER_OIDC_ISSUER=https://YOUR_TENANT.us.auth0.com
ADMIN_OIDC_AUDIENCE=floit-admin
PARTNER_OIDC_AUDIENCE=floit-partner
ADMIN_CATALOG_DELEGATE_EMAIL=ops@quegym.com
# Absolute public URL of this service (no trailing slash). Used for photo URLs in staging/prod.
# If unset on Railway, falls back to https://$RAILWAY_PUBLIC_DOMAIN.
# PARTNER_PUBLIC_BASE_URL=https://floitpartner-service-production.up.railway.app
# Durable uploads dir (Railway volume). Also stores blobBase64 in Postgres as fallback.
# PARTNER_MEDIA_DIR=/data/uploads